{
  "expo": {
    "name": "Anya's Journey",
    "slug": "anyas-journey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anyasjourney.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#b8a07e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anyasjourney.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Anya's Journey uses your location to show accessible playgrounds near you."
        }
      ]
    ],
    "scheme": "anyasjourney",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/anyasjourney"
    }
  }
}